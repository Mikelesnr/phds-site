APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Use 'reverb' once Reverb is installed (composer require laravel/reverb). 'log' keeps chat working by polling.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeded accounts (php artisan db:seed). Fill the passwords in your real .env,
# never commit them. UserSeeder creates one admin and two staff users.
SEED_ADMIN_NAME="PHDS Admin"
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=

SEED_STAFF_1_NAME="Achieng Odero"
SEED_STAFF_1_EMAIL=achieng.odero@example.org
SEED_STAFF_2_NAME="Kevin Mwangi"
SEED_STAFF_2_EMAIL=kevin.mwangi@example.org
SEED_STAFF_PASSWORD=

PHDS_CONTACT_EMAIL=contact@example.org
PHDS_CONTACT_LOCATION='Lake Victoria Basin, Kenya'

# Website chatbot (Gemini). The key stays on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_ENABLED=true
CHATBOT_MAX_OUTPUT_TOKENS=450
CHATBOT_PER_MINUTE=8
CHATBOT_PER_IP_DAILY=40
CHATBOT_DAILY_LIMIT=500

# Realtime team chat (Reverb). Leave REVERB_APP_KEY empty to run without websockets.
REVERB_APP_ID=phds
REVERB_APP_KEY=
REVERB_APP_SECRET=
# What the browser connects to. Locally: localhost / 8080 / http. On Render: your domain / 443 / https.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Where Laravel itself publishes events (the local Reverb server).
REVERB_PUBLISH_HOST=127.0.0.1
REVERB_PUBLISH_PORT=8080
REVERB_PUBLISH_SCHEME=http
# How often the chat checks for news when websockets are off.
CHAT_POLL_SECONDS=6
